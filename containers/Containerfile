ARG PYTHON_VERSION=3.14
ARG UV_VERSION=0.12.24

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-cli



# --- RUNTIME BASE (no uv) ---
FROM python:${PYTHON_VERSION}-alpine AS runtime-base

ARG HOME=/backend
ENV VIRTUAL_ENV=/opt/venv
ENV HOME=$HOME \
    PATH="$VIRTUAL_ENV/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN ln -s /bin/ash /bin/bash
RUN apk add --no-cache just


# --- DEV BASE (with uv) ---
FROM ghcr.io/astral-sh/uv:${UV_VERSION}-python${PYTHON_VERSION}-alpine AS base

ARG HOME=/backend
ENV VIRTUAL_ENV=/opt/venv
ENV HOME=$HOME \
    PATH="$VIRTUAL_ENV/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=$VIRTUAL_ENV

RUN ln -s /bin/ash /bin/bash
RUN apk add --no-cache just



# --- LOCK EXPORT STAGE ---
# Exports only the public, non-dev dependencies. This stage re-runs on every
# uv.lock change (cheap), but its *output* only changes when a public dependency
# changes. Because COPY --from is keyed on content, bumping a package from the
# private index (prod group) no longer invalidates the big venv layer below.
FROM ghcr.io/astral-sh/uv:${UV_VERSION}-python${PYTHON_VERSION}-alpine AS lock-export

WORKDIR /lock
RUN --mount=type=bind,source=backend/uv.lock,target=uv.lock \
    --mount=type=bind,source=backend/pyproject.toml,target=pyproject.toml \
    uv export --frozen --no-dev --no-emit-project -o /requirements.txt



# --- BUILDER STAGE (public deps) ---
FROM ghcr.io/astral-sh/uv:${UV_VERSION}-python${PYTHON_VERSION}-alpine AS builder

ARG HOME
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR $HOME

COPY --from=lock-export /requirements.txt /tmp/requirements.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /opt/venv && \
    uv pip sync --python /opt/venv /tmp/requirements.txt



# --- BUILDER STAGE (private prod group) ---
# Separate stage so the development target never needs the PyPI secret.
# Credentials come from the secret as an env var for this RUN only, so nothing
# is written to disk (uv auth login used to store them under $HOME in the image).
# Adjust IKSO to the `name` of the index in [[tool.uv.index]] in pyproject.toml.
FROM builder AS builder-prod

# Host-wide login , but HOME points at a tmpfs for this RUN only,
# so the stored credentials never end up in a layer or in the build cache.
RUN --mount=type=secret,id=PYPI_PASSWORD,env=PYPI_PASSWORD \
    --mount=type=tmpfs,target=/tmp/uv-auth \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=backend/uv.lock,target=uv.lock \
    --mount=type=bind,source=backend/pyproject.toml,target=pyproject.toml \
    export HOME=/tmp/uv-auth UV_CACHE_DIR=/root/.cache/uv && \
    uv auth login pypi.ikso.net -u ikso --password "$PYPI_PASSWORD" && \
    uv sync --frozen --no-dev --group prod --no-install-project


# --- DEVELOPMENT STAGE ---
FROM base AS development

COPY --from=builder $VIRTUAL_ENV $VIRTUAL_ENV

RUN --mount=from=uv-cli,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=backend/uv.lock,target=uv.lock \
    --mount=type=bind,source=backend/pyproject.toml,target=pyproject.toml \
    uv sync --frozen

WORKDIR $HOME



# --- VITE STAGE ---
FROM node:24-alpine AS vite-build

ARG VITE_API_URL
ARG VITE_WEBSITE_URL
ARG VITE_STRIPE_PUBLISHABLE_KEY

RUN \
--mount=type=cache,target=/root/.npm,rw \
--mount=type=bind,source=uk-aligxilo/package.json,target=package.json \
--mount=type=bind,source=uk-aligxilo/package-lock.json,target=package-lock.json \
npm ci

COPY uk-aligxilo/ /uk-aligxilo/
WORKDIR /uk-aligxilo
RUN npm run build



# --- PRODUCTION STAGE ---
FROM runtime-base AS production

ARG USER_ID=1030  # On ikso.net: compose
ARG GROUP_ID=33  # On ikso.net: www-data
ARG GIT_BRANCH=no-branch
ARG COMMIT_HASH=no-hash
ARG VITE_OUT_DIR

ENV USER=dj \
    USER_ID=$USER_ID \
    GROUP_ID=$GROUP_ID \
    UK_GIT_BRANCH=$GIT_BRANCH \
    UK_COMMIT_HASH=$COMMIT_HASH

# Granian serves the collected static files itself, the route must match STATIC_URL.
# One year of cache: file names are hashed by ManifestStaticFilesStorage or Vite.
ENV GRANIAN_INTERFACE=wsgi \
    GRANIAN_HOST=0.0.0.0 \
    GRANIAN_PORT=8000 \
    GRANIAN_LOG_ACCESS_ENABLED=true \
    GRANIAN_STATIC_PATH_ROUTE=/static \
    GRANIAN_STATIC_PATH_MOUNT=/assets/static \
    GRANIAN_STATIC_PATH_EXPIRES=31536000

RUN \
addgroup -g $GROUP_ID $USER && \
adduser -D -h $HOME -u $USER_ID -G $USER $USER && \
install --directory -o $USER -g $USER -m 0755 /assets

# Root-owned (read-only for the app user) and --link makes the layer
# independent of the base layers, so it stays reusable when the base changes.
COPY --link --from=builder-prod $VIRTUAL_ENV $VIRTUAL_ENV

COPY --chown=$USER:$GROUP_ID backend $HOME/

WORKDIR $HOME

# Install Vite/Vue project
COPY --from=vite-build --chown=$USER:$GROUP_ID $VITE_OUT_DIR $VITE_OUT_DIR

COPY --from=vite-build --chmod=+x /uk-aligxilo/replace-vite-env.sh /bin/

USER $USER

RUN UK_RETEJO_ENVIRONMENT="build" python manage.py collectstatic -v 2 --noinput

EXPOSE 8000

CMD ["granian", "config.wsgi:application"]
